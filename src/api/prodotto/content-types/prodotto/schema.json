    "in_evidenza": {
      "type": "boolean"
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "prodotti"
    },
    "collezione": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collezione.collezione",
      "inversedBy": "prodotti"
    }
